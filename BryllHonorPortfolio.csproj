<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bryll-honor-portfolio-mvc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Web SDK already includes Data/*.json as Content items by default (that's
         what triggered the "duplicate Content items" build error) — this just adds
         copy-to-output metadata to those existing items instead of re-including them,
         so comments.json/projects.json land next to the built app and survive publish. -->
    <Content Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
