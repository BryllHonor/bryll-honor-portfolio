@model HomeIndexViewModel
@{
    ViewData["Title"] = "Bryll Honor — Portfolio";
}
<div class="wrap">
    <section class="title-block">
        <div class="title-block__top">
            <div>
                <h1 class="title-block__title">Coursework, filed sheet by sheet.</h1>
                <p class="title-block__lede">
                    Twelve submissions from prelims through the prefinal exam, each pushed to its
                    own GitHub repository. This is the index; every entry opens onto its own sheet
                    with the repo link, a short description, and a margin for notes.
                </p>
            </div>
        </div>
        <dl class="title-block__fields">
            <div class="title-block__field">
                <dt>Drafted by</dt>
                <dd>Bryll Honor</dd>
            </div>
            <div class="title-block__field">
                <dt>Scope</dt>
                <dd>BSIT 31E3, IT Elective 2</dd>
            </div>
            <div class="title-block__field">
                <dt>Sheets</dt>
                <dd>@Model.Total</dd>
            </div>
        </dl>
    </section>

    <partial name="_Flash" />

    <section id="contents" class="index">
        @{ var sheetNumber = 0; }
        @foreach (var group in Model.Groups)
        {
            <div class="term-divider">
                <span class="term-divider__label">@group.Term</span>
                <span class="term-divider__line"></span>
            </div>
            <ol class="sheet-list">
                @foreach (var project in group.Projects)
                {
                    sheetNumber++;
                    <li class="sheet-row">
                        <a class="sheet-row__link" href="/projects/@project.Id">
                            <span class="sheet-row__num">@sheetNumber.ToString("00")</span>
                            <img
                                class="sheet-row__thumb"
                                src="@project.Thumbnail"
                                alt=""
                                width="88"
                                height="64"
                                loading="lazy" />
                            <span class="sheet-row__body">
                                <span class="sheet-row__code">@project.Code</span>
                                <span class="sheet-row__title">@project.Title</span>
                                <span class="sheet-row__desc">@project.Description</span>
                            </span>
                            <span class="sheet-row__cta">View sheet</span>
                        </a>
                    </li>
                }
            </ol>
        }
    </section>
</div>
